# Dependencies are downloaded from package.json/package-lock.json.
# Each developer and deployment environment installs its own compatible copy.
node_modules/

# Production output is generated from source during deployment.
/build/
/dist/

# Local environment variables can contain machine-specific settings or secrets.
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local Vercel project metadata and credentials.
.vercel/

# Package-manager and test output.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# macOS Finder metadata.
.DS_Store
